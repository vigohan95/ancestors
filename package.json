    "haunt": "tsx src/temporal/start.ts"
  },
  "dependencies": {
    "@mastra/core": "^1.80.0",
    "@mastra/memory": "^1.39.1",
    "@mastra/libsql": "^1.27.1",
    "@temporalio/activity": "^1.25.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/worker": "^1.25.0",
    "@temporalio/workflow": "^1.25.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  }
